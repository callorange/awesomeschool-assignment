# Django는 저장소 루트의 .env를 자동 로딩하며 이미 설정된 환경 변수를 우선합니다.
# 로컬 개발 전용. 두 필수 비밀값은 README의 준비 명령으로 .env에 생성합니다.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=awesomeschool
POSTGRES_USER=awesomeschool
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432

# 운영 전용: config.settings.prod를 실행 환경에서 선택하고 DEBUG=false로 설정합니다.
# CloudFront host는 scheme/경로/끝 슬래시 없이 지정합니다. 키는 IAM role로 주입합니다.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=
